---
import { profile, socials } from '../site.config';

const year = new Date().getFullYear();
---

<footer class="border-t border-border">
  <div
    class="mx-auto flex max-w-3xl flex-col gap-4 px-6 py-10 text-sm text-muted sm:flex-row sm:items-center sm:justify-between"
  >
    <p>© {year} {profile.fullName}. Built with Astro, hosted on GitHub Pages.</p>
    <ul class="flex gap-4">
      {
        socials.map((social) => (
          <li>
            <a
              href={social.href}
              class="transition hover:text-accent"
              rel={social.href.startsWith('http') ? 'me noopener' : undefined}
            >
              {social.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</footer>
