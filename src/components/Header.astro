---
import { profile } from '../site.config';
import { withBase } from '../lib/url';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  activePath: string;
}
const { activePath } = Astro.props;

// `mobile: false` links are hidden below the sm breakpoint so the header fits
// a 360px viewport; those sections are one scroll away on the homepage anyway.
const links = [
  { label: 'Work', href: '/projects', match: '/projects', mobile: true },
  { label: 'About', href: '/#about', match: null, mobile: false },
  { label: 'Experience', href: '/#experience', match: null, mobile: false },
  { label: 'Contact', href: '/#contact', match: null, mobile: true },
];

const isActive = (match: string | null) =>
  match !== null && activePath.replace(/\/$/, '').endsWith(match);
---

<header class="sticky top-0 z-40 border-b border-border bg-bg/85 backdrop-blur">
  <div class="mx-auto flex h-16 max-w-3xl items-center justify-between gap-4 px-5 sm:px-6">
    <a
      href={withBase('/')}
      class="font-display text-xl tracking-tight transition hover:text-accent"
    >
      {profile.name}<span class="text-accent">.</span>
    </a>

    <nav aria-label="Main" class="flex items-center gap-1 sm:gap-2">
      {
        links.map((link) => (
          <a
            href={withBase(link.href)}
            aria-current={isActive(link.match) ? 'page' : undefined}
            class:list={[
              'rounded-md px-2 py-1.5 text-sm transition hover:text-fg',
              isActive(link.match) ? 'text-fg' : 'text-muted',
              link.mobile ? '' : 'hidden sm:inline-block',
            ]}
          >
            {link.label}
          </a>
        ))
      }
      <div class="ml-1 sm:ml-2"><ThemeToggle /></div>
    </nav>
  </div>
</header>
