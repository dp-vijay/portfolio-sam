---
interface Props {
  id: string;
  title: string;
  /** Optional link rendered at the right of the section heading. */
  action?: { label: string; href: string };
}
const { id, title, action } = Astro.props;
---

<section id={id} class="border-t border-border py-14 sm:py-16">
  <div class="mb-8 flex items-baseline justify-between gap-4">
    <h2 class="font-display text-2xl tracking-tight sm:text-3xl">{title}</h2>
    {
      action && (
        <a href={action.href} class="text-sm text-muted transition hover:text-accent">
          {action.label} →
        </a>
      )
    }
  </div>
  <slot />
</section>
