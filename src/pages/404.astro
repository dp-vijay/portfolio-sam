---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/url';
---

<BaseLayout title="Not found" description="That page does not exist.">
  <div class="mx-auto flex max-w-3xl flex-col items-start px-6 py-24 sm:py-32">
    <p class="font-mono text-sm text-accent">404</p>
    <h1 class="mt-4 font-display text-3xl tracking-tight sm:text-4xl">
      That page doesn't exist
    </h1>
    <p class="mt-4 max-w-prose leading-relaxed text-muted">
      The link may be out of date, or the page may have moved.
    </p>
    <a
      href={withBase('/')}
      class="mt-8 rounded-lg bg-accent px-4 py-2 text-sm font-medium text-bg transition hover:opacity-90"
    >
      Back home
    </a>
  </div>
</BaseLayout>
