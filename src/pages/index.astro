---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { profile, socials, skills, experience } from '../site.config';
import { withBase } from '../lib/url';

const featured = (await getCollection('projects'))
  .filter((project) => project.data.featured)
  .sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout>
  <div class="mx-auto max-w-3xl px-6">
    <!-- Hero -->
    <section class="py-16 sm:py-24">
      {
        profile.status && (
          <p class="mb-6 inline-flex items-center gap-2 rounded-full border border-border px-3 py-1 text-xs text-muted">
            <span class="size-1.5 rounded-full bg-accent" />
            {profile.status}
          </p>
        )
      }

      <h1 class="font-display text-4xl leading-[1.1] tracking-tight sm:text-6xl">
        {profile.fullName}
      </h1>
      <p class="mt-4 text-lg text-muted sm:text-xl">
        {profile.role} <span class="text-border">·</span> {profile.location}
      </p>

      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a
          href={`mailto:${profile.email}`}
          class="rounded-lg bg-accent px-4 py-2 text-sm font-medium text-bg transition hover:opacity-90"
        >
          Get in touch
        </a>
        <a
          href={withBase('/projects')}
          class="rounded-lg border border-border px-4 py-2 text-sm font-medium transition hover:border-accent"
        >
          View work
        </a>
        {
          profile.resumeUrl && (
            <a
              href={profile.resumeUrl}
              class="px-2 py-2 text-sm text-muted transition hover:text-accent"
            >
              Résumé ↗
            </a>
          )
        }
      </div>
    </section>

    <Section id="about" title="About">
      <div class="space-y-4 leading-relaxed text-muted">
        {profile.bio.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </Section>

    <Section
      id="work"
      title="Selected work"
      action={{ label: 'All projects', href: withBase('/projects') }}
    >
      <ul class="grid gap-4 sm:grid-cols-2">
        {featured.map((project) => <ProjectCard project={project} />)}
      </ul>
    </Section>

    <Section id="skills" title="Skills">
      <dl class="grid gap-6 sm:grid-cols-2">
        {
          skills.map((group) => (
            <div>
              <dt class="font-mono text-xs uppercase tracking-widest text-muted">
                {group.group}
              </dt>
              <dd class="mt-2 text-sm leading-relaxed">{group.items.join(' · ')}</dd>
            </div>
          ))
        }
      </dl>
    </Section>

    <Section id="experience" title="Experience">
      <ol class="space-y-8">
        {
          experience.map((job) => (
            <li class="grid gap-1 sm:grid-cols-[9rem_1fr] sm:gap-6">
              <p class="pt-0.5 font-mono text-xs text-muted sm:text-right">{job.period}</p>
              <div>
                <h3 class="font-medium">
                  {job.role} <span class="text-muted">at</span>{' '}
                  {job.companyUrl ? (
                    <a href={job.companyUrl} class="text-accent hover:underline">
                      {job.company}
                    </a>
                  ) : (
                    job.company
                  )}
                </h3>
                <p class="mt-2 text-sm leading-relaxed text-muted">{job.summary}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </Section>

    <Section id="contact" title="Contact">
      <p class="max-w-prose leading-relaxed text-muted">
        The fastest way to reach me is email. I read everything and reply to anything that
        isn't a recruiter template.
      </p>
      <div class="mt-6 flex flex-wrap gap-3">
        {
          socials.map((social) => (
            <a
              href={social.href}
              rel={social.href.startsWith('http') ? 'me noopener' : undefined}
              class="rounded-lg border border-border px-4 py-2 text-sm transition hover:border-accent hover:text-accent"
            >
              {social.label}
            </a>
          ))
        }
      </div>
    </Section>
  </div>
</BaseLayout>
